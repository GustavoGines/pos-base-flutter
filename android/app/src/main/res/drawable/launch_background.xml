<?xml version="1.0" encoding="utf-8"?>
<!-- Splash nativo Caja4U (Android < 12): fondo de marca + ícono centrado.
     Se reemplaza automáticamente por la animación Flutter al dibujarse el primer frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/caja4u_splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon" />
    </item>
</layer-list>
