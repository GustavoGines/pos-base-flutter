<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31): SplashScreen del sistema con la marca Caja4U (modo claro) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/caja4u_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/caja4u_splash_background</item>
    </style>
</resources>
